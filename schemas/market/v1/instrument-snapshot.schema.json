{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brullik/brullik-bybit-grid-bot-research/schemas/market/v1/instrument-snapshot.schema.json",
  "title": "Instrument snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_time_ms", "category", "instrument_id", "source_symbol_id", "symbol",
    "contract_type", "status", "base_coin", "quote_coin", "settle_coin",
    "launch_time_ms", "delivery_time_ms", "tick_size", "quantity_step",
    "min_order_quantity", "max_order_quantity", "min_leverage", "max_leverage",
    "funding_interval_minutes", "source_payload_sha256"
  ],
  "properties": {
    "snapshot_time_ms": {"type": "integer", "minimum": 0},
    "category": {"type": "string", "minLength": 1},
    "instrument_id": {"type": "integer", "minimum": 1},
    "source_symbol_id": {"type": "integer", "minimum": 1},
    "symbol": {"type": "string", "minLength": 1},
    "contract_type": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "base_coin": {"type": "string", "minLength": 1},
    "quote_coin": {"type": "string", "minLength": 1},
    "settle_coin": {"type": "string", "minLength": 1},
    "launch_time_ms": {"type": "integer", "minimum": 0},
    "delivery_time_ms": {"type": ["integer", "null"], "minimum": 0},
    "tick_size": {"$ref": "#/$defs/positiveDecimal"},
    "quantity_step": {"$ref": "#/$defs/positiveDecimal"},
    "min_order_quantity": {"$ref": "#/$defs/positiveDecimal"},
    "max_order_quantity": {"$ref": "#/$defs/positiveDecimal"},
    "min_leverage": {"$ref": "#/$defs/positiveDecimal"},
    "max_leverage": {"$ref": "#/$defs/positiveDecimal"},
    "funding_interval_minutes": {"type": ["integer", "null"], "minimum": 1},
    "source_payload_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "positiveDecimal": {"type": "string", "pattern": "^(?:0*[1-9][0-9]*)(?:\\.[0-9]+)?$|^0*\\.0*[1-9][0-9]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
