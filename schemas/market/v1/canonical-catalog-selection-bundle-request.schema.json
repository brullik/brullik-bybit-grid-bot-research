{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brullik/brullik-bybit-grid-bot-research/schemas/market/v1/canonical-catalog-selection-bundle-request.schema.json",
  "title": "Canonical catalog selection bundle request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_id", "catalog_content_sha256", "catalog_revision",
    "consumer_software_identity", "contract", "sources"
  ],
  "properties": {
    "bundle_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$"},
    "catalog_content_sha256": {"$ref": "#/$defs/sha256"},
    "catalog_revision": {"type": "integer", "minimum": 1},
    "consumer_software_identity": {"type": "string", "pattern": "^git:[0-9a-f]{40}$"},
    "contract": {"const": "grid.canonical-catalog-selection-bundle-request/v1"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["campaign_id", "end_time_ms", "start_time_ms"],
        "properties": {
          "campaign_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$"},
          "end_time_ms": {"type": "integer", "minimum": 0, "multipleOf": 60000},
          "start_time_ms": {"type": "integer", "minimum": 0, "multipleOf": 60000}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
