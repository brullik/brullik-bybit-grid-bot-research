{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brullik/brullik-bybit-grid-bot-research/schemas/market/v1/public-history-campaign-request.schema.json",
  "title": "Public history campaign request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "campaign_id",
    "kinds",
    "symbols",
    "start_ms",
    "end_ms",
    "lifecycle_policy"
  ],
  "properties": {
    "contract": {"const": "grid.public-history-campaign-request/v1"},
    "campaign_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$"},
    "kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["trade", "mark", "funding"]}
    },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "maxItems": 700,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z0-9]+$"}
    },
    "start_ms": {"type": "integer", "minimum": 0, "multipleOf": 60000},
    "end_ms": {"type": "integer", "minimum": 0, "multipleOf": 60000},
    "lifecycle_policy": {"const": "registry-lifecycle-intersection-v1"},
    "history_page_limit": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 1000},
    "funding_page_limit": {"type": "integer", "minimum": 1, "maximum": 200, "default": 200},
    "funding_page_span_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10080,
      "default": 10080
    },
    "workers": {"type": "integer", "minimum": 1, "maximum": 32, "default": 24},
    "target_rps": {"type": "integer", "minimum": 1, "maximum": 96, "default": 10},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 5, "default": 3}
  }
}
