{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grid.canonical-dataset-selection-request/v1",
  "title": "Canonical dataset catalog selection request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog_content_sha256",
    "catalog_revision",
    "consumer_software_identity",
    "dataset_ids",
    "dataset_type",
    "end_time_ms",
    "instrument_filter",
    "request_schema",
    "start_time_ms"
  ],
  "properties": {
    "catalog_content_sha256": {"$ref": "#/$defs/sha256"},
    "catalog_revision": {"type": "integer", "minimum": 1},
    "consumer_software_identity": {"type": "string", "pattern": "^git:[0-9a-f]{40}$"},
    "dataset_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"}
    },
    "dataset_type": {"enum": ["trade_kline_1m", "mark_kline_1m"]},
    "end_time_ms": {"type": "integer", "minimum": 0, "multipleOf": 60000},
    "instrument_filter": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {"mode": {"const": "all"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["instrument_ids", "mode"],
          "properties": {
            "instrument_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "integer", "minimum": 1, "maximum": 4294967295}
            },
            "mode": {"const": "include"}
          }
        }
      ]
    },
    "request_schema": {"const": "grid.canonical-dataset-selection-request/v1"},
    "start_time_ms": {"type": "integer", "minimum": 0, "multipleOf": 60000}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
