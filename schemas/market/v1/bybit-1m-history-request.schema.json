{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brullik/brullik-bybit-grid-bot-research/schemas/market/v1/bybit-1m-history-request.schema.json",
  "title": "Bybit public one-minute history request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "job_id", "kind", "series"],
  "properties": {
    "contract": {"const": "grid.bybit-1m-history-request/v1"},
    "job_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "kind": {"enum": ["trade", "mark"]},
    "series": {
      "type": "array",
      "minItems": 1,
      "maxItems": 700,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "start_ms", "end_ms"],
        "properties": {
          "symbol": {"type": "string", "pattern": "^[A-Z0-9]+$"},
          "start_ms": {"type": "integer", "minimum": 0, "multipleOf": 60000},
          "end_ms": {"type": "integer", "minimum": 0, "multipleOf": 60000}
        }
      }
    },
    "page_limit": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 1000},
    "workers": {"type": "integer", "minimum": 1, "maximum": 32, "default": 24},
    "target_rps": {"type": "integer", "minimum": 1, "maximum": 96, "default": 10},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 5, "default": 3},
    "max_http_requests": {"type": "integer", "minimum": 1, "maximum": 100000, "default": 100000}
  }
}
