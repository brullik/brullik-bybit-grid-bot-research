{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brullik/brullik-bybit-grid-bot-research/schemas/market/v1/history-campaign-receipt.schema.json",
  "title": "Public history campaign receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact", "artifact_sha256", "contract", "status"],
  "properties": {
    "artifact": {"enum": ["plan.json", "manifest.json"]},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contract": {"const": "grid.history-campaign-receipt/v1"},
    "status": {"const": "complete"}
  }
}
