{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brullik/brullik-bybit-grid-bot-research/schemas/market/v1/history-campaign-publication-plan.schema.json",
  "title": "Receipt-resumable canonical history campaign publication plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "campaign_id",
    "capacity_evidence_sha256",
    "contract",
    "dataset_count",
    "instrument_evidence_sha256",
    "jobs",
    "publication_policy",
    "publisher_software_identity",
    "row_count",
    "source_campaign_manifest_sha256",
    "source_campaign_plan_sha256"
  ],
  "properties": {
    "campaign_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$"},
    "capacity_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "contract": {"const": "grid.history-campaign-publication-plan/v1"},
    "dataset_count": {"type": "integer", "minimum": 1, "maximum": 2880},
    "instrument_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "jobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2880,
      "items": {"$ref": "#/$defs/job"}
    },
    "publication_policy": {"$ref": "#/$defs/publicationPolicy"},
    "publisher_software_identity": {
      "type": "string",
      "pattern": "^git:[0-9a-f]{40}$"
    },
    "row_count": {"type": "integer", "minimum": 1},
    "source_campaign_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "source_campaign_plan_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "publicationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "child_order",
        "max_concurrent_writers",
        "private_endpoints",
        "receipt_resume",
        "tick_rows_requested"
      ],
      "properties": {
        "child_order": {"const": "source-campaign-sequence-v1"},
        "max_concurrent_writers": {"const": 1},
        "private_endpoints": {"const": false},
        "receipt_resume": {"const": true},
        "tick_rows_requested": {"const": false}
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "canonical_admission": ["source_row_count"],
        "source_row_count": ["canonical_admission"]
      },
      "required": [
        "dataset_id",
        "dataset_root",
        "dataset_type",
        "input_table_sha256",
        "job_id",
        "kind",
        "planned_peak_memory_bytes",
        "publication_request_sha256",
        "required_free_bytes",
        "row_count",
        "sequence",
        "source_job_manifest_sha256",
        "source_job_plan_sha256",
        "source_job_root"
      ],
      "properties": {
        "canonical_admission": {"$ref": "#/$defs/canonicalAdmission"},
        "dataset_id": {"type": "string", "pattern": "^(?:trade-1m|mark-1m|funding)-[0-9a-f]{24}$"},
        "dataset_root": {
          "type": "string",
          "pattern": "^datasets/(?:trade-1m|mark-1m|funding)-[0-9a-f]{24}$"
        },
        "dataset_type": {"enum": ["trade_kline_1m", "mark_kline_1m", "funding_event"]},
        "input_table_sha256": {"$ref": "#/$defs/sha256"},
        "job_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
        "kind": {"enum": ["trade", "mark", "funding"]},
        "planned_peak_memory_bytes": {"type": "integer", "minimum": 1},
        "publication_request_sha256": {"$ref": "#/$defs/sha256"},
        "required_free_bytes": {"type": "integer", "minimum": 1},
        "row_count": {"type": "integer", "minimum": 0},
        "sequence": {"type": "integer", "minimum": 0, "maximum": 2879},
        "source_job_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "source_job_plan_sha256": {"$ref": "#/$defs/sha256"},
        "source_row_count": {"type": "integer", "minimum": 1},
        "source_job_root": {
          "type": "string",
          "pattern": "^\\.(?:landing|funding-landing)/[a-z0-9][a-z0-9._-]+--[0-9a-f]{16}$"
        }
      }
    },
    "canonicalAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admitted_row_count",
        "excluded_row_count",
        "excluded_rows_sha256",
        "policy",
        "reason_counts",
        "source_row_count"
      ],
      "properties": {
        "admitted_row_count": {"type": "integer", "minimum": 0},
        "excluded_row_count": {"type": "integer", "minimum": 1},
        "excluded_rows_sha256": {"$ref": "#/$defs/sha256"},
        "policy": {"const": "canonical-candle-representation-admission-v1"},
        "reason_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["volume_exceeds_canonical_scale"],
          "properties": {
            "volume_exceeds_canonical_scale": {"type": "integer", "minimum": 0}
          }
        },
        "source_row_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
