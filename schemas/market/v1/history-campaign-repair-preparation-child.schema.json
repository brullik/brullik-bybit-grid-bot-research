{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brullik/brullik-bybit-grid-bot-research/schemas/market/v1/history-campaign-repair-preparation-child.schema.json",
  "title": "History campaign repair preparation child v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "aggregate_child_audit_content_sha256",
    "classification",
    "content_sha256",
    "contract",
    "coverage_audit_artifact_sha256",
    "coverage_audit_content_sha256",
    "gap_range_count",
    "kind",
    "missing_minute_count",
    "planned_max_http_requests",
    "repair_plan_artifact_sha256",
    "repair_plan_content_sha256",
    "sequence",
    "status",
    "task_count"
  ],
  "properties": {
    "aggregate_child_audit_content_sha256": {"$ref": "#/$defs/sha256"},
    "classification": {
      "enum": [
        "eligible",
        "no-missing-minute-gap",
        "non-gap-audit-blocker-remains",
        "reason-policy-incompatible",
        "repair-request-limit-exceeded",
        "repair-task-limit-exceeded"
      ]
    },
    "content_sha256": {"$ref": "#/$defs/sha256"},
    "contract": {"const": "grid.history-campaign-repair-preparation-child/v1"},
    "coverage_audit_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "coverage_audit_content_sha256": {"$ref": "#/$defs/sha256"},
    "gap_range_count": {"type": "integer", "minimum": 0},
    "kind": {"enum": ["trade", "mark"]},
    "missing_minute_count": {"type": "integer", "minimum": 0},
    "planned_max_http_requests": {"type": "integer", "minimum": 0},
    "repair_plan_artifact_sha256": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "repair_plan_content_sha256": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "sequence": {"type": "integer", "minimum": 0, "maximum": 2879},
    "status": {
      "enum": [
        "eligible-repair-plan-prepared",
        "ineligible-candle-blocker-preserved"
      ]
    },
    "task_count": {"type": "integer", "minimum": 0, "maximum": 1000}
  },
  "allOf": [
    {
      "if": {"properties": {"classification": {"const": "eligible"}}},
      "then": {
        "properties": {
          "repair_plan_artifact_sha256": {"$ref": "#/$defs/sha256"},
          "repair_plan_content_sha256": {"$ref": "#/$defs/sha256"},
          "status": {"const": "eligible-repair-plan-prepared"},
          "task_count": {"type": "integer", "minimum": 1}
        }
      },
      "else": {
        "properties": {
          "planned_max_http_requests": {"const": 0},
          "repair_plan_artifact_sha256": {"type": "null"},
          "repair_plan_content_sha256": {"type": "null"},
          "status": {"const": "ineligible-candle-blocker-preserved"},
          "task_count": {"const": 0}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
