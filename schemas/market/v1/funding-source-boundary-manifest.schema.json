{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brullik/brullik-bybit-grid-bot-research/schemas/market/v1/funding-source-boundary-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adaptive_throttling",
    "completed_at_ms",
    "contract",
    "event_count",
    "http_attempt_count",
    "page_count",
    "pages",
    "plan_sha256",
    "results",
    "source_policy",
    "status",
    "symbol_count"
  ],
  "properties": {
    "adaptive_throttling": {"$ref": "#/$defs/adaptiveThrottling"},
    "completed_at_ms": {"type": "integer", "minimum": 0},
    "contract": {"const": "grid.bybit-funding-source-boundary/v1"},
    "event_count": {"type": "integer", "minimum": 2},
    "http_attempt_count": {"type": "integer", "minimum": 1, "maximum": 1792000},
    "page_count": {"type": "integer", "minimum": 1, "maximum": 358400},
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 358400,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact", "artifact_sha256", "attempt_count", "row_count", "sequence"],
        "properties": {
          "artifact": {"type": "string", "pattern": "^pages/[0-9]{10}-[0-9]{4}\\.json$"},
          "artifact_sha256": {"$ref": "#/$defs/sha256"},
          "attempt_count": {"type": "integer", "minimum": 1, "maximum": 5},
          "row_count": {"type": "integer", "minimum": 0, "maximum": 200},
          "sequence": {"type": "integer", "minimum": 0, "maximum": 511}
        }
      }
    },
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 700,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canonical_start_ms",
          "event_count",
          "first_observed_settlement_ms",
          "instrument_id",
          "page_count",
          "predecessor_settlement_ms",
          "symbol"
        ],
        "properties": {
          "canonical_start_ms": {"type": "integer", "minimum": 0, "multipleOf": 60000},
          "event_count": {"type": "integer", "minimum": 2},
          "first_observed_settlement_ms": {"type": "integer", "minimum": 0, "multipleOf": 60000},
          "instrument_id": {"type": "integer", "minimum": 1, "maximum": 4294967295},
          "page_count": {"type": "integer", "minimum": 1, "maximum": 512},
          "predecessor_settlement_ms": {"type": "integer", "minimum": 0, "multipleOf": 60000},
          "symbol": {"type": "string", "pattern": "^[A-Z0-9]+$"}
        }
      }
    },
    "source_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "endpoint", "pagination", "persisted_fields", "private_credentials_used", "source_rates_validated_not_retained"],
      "properties": {
        "category": {"const": "linear"},
        "endpoint": {"const": "/v5/market/funding/history"},
        "pagination": {"const": "inclusive-end-oldest-minus-one-v1"},
        "persisted_fields": {"const": ["fundingRateTimestamp"]},
        "private_credentials_used": {"const": false},
        "source_rates_validated_not_retained": {"const": true}
      }
    },
    "status": {"const": "complete"},
    "symbol_count": {"type": "integer", "minimum": 1, "maximum": 700}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adaptiveThrottling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automatic_increase_count", "complete_header_observation_count", "configured_target_rps", "cooldown_event_count", "final_effective_rps", "header_absent_observation_count", "invalid_header_observation_count", "low_headroom_event_count", "maximum_cooldown_ms", "minimum_effective_rps", "policy", "rate_limit_event_count", "rate_reduction_count", "response_observation_count"],
      "properties": {
        "automatic_increase_count": {"const": 0},
        "complete_header_observation_count": {"type": "integer", "minimum": 0, "maximum": 1792000},
        "configured_target_rps": {"type": "integer", "minimum": 1, "maximum": 96},
        "cooldown_event_count": {"type": "integer", "minimum": 0, "maximum": 1792000},
        "final_effective_rps": {"type": "integer", "minimum": 1, "maximum": 96},
        "header_absent_observation_count": {"type": "integer", "minimum": 0, "maximum": 1792000},
        "invalid_header_observation_count": {"type": "integer", "minimum": 0, "maximum": 1792000},
        "low_headroom_event_count": {"type": "integer", "minimum": 0, "maximum": 1792000},
        "maximum_cooldown_ms": {"type": "integer", "minimum": 0, "maximum": 600000},
        "minimum_effective_rps": {"type": "integer", "minimum": 1, "maximum": 96},
        "policy": {"const": "bybit-v5-response-header-decrease-only-v1"},
        "rate_limit_event_count": {"type": "integer", "minimum": 0, "maximum": 1792000},
        "rate_reduction_count": {"type": "integer", "minimum": 0, "maximum": 1792000},
        "response_observation_count": {"type": "integer", "minimum": 0, "maximum": 1792000}
      }
    }
  }
}
