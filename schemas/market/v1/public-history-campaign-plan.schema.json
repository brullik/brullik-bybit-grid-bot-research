{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brullik/brullik-bybit-grid-bot-research/schemas/market/v1/public-history-campaign-plan.schema.json",
  "title": "Resolved public history campaign plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "campaign_id",
    "campaign_request",
    "campaign_request_sha256",
    "capacity_evidence_sha256",
    "contract",
    "instrument_evidence_sha256",
    "job_count",
    "jobs",
    "lifecycle_policy",
    "source_policy"
  ],
  "properties": {
    "campaign_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$"},
    "campaign_request": {"type": "object"},
    "campaign_request_sha256": {"$ref": "#/$defs/sha256"},
    "capacity_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "contract": {"const": "grid.public-history-campaign-plan/v1"},
    "instrument_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "job_count": {"type": "integer", "minimum": 1, "maximum": 2880},
    "jobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2880,
      "items": {"$ref": "#/$defs/job"}
    },
    "lifecycle_policy": {"const": "registry-lifecycle-intersection-v1"},
    "source_policy": {"$ref": "#/$defs/sourcePolicy"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourcePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["funding", "mark", "trade", "tick_rows_requested"],
      "properties": {
        "funding": {"const": "/v5/market/funding/history"},
        "mark": {"const": "/v5/market/mark-price-kline"},
        "trade": {"const": "/v5/market/kline"},
        "tick_rows_requested": {"const": false}
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bucket",
        "job_id",
        "job_plan_sha256",
        "job_root",
        "kind",
        "month",
        "planned_page_count",
        "request",
        "request_sha256",
        "sequence"
      ],
      "properties": {
        "bucket": {"type": "integer", "minimum": 0, "maximum": 7},
        "job_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
        "job_plan_sha256": {"$ref": "#/$defs/sha256"},
        "job_root": {
          "type": "string",
          "pattern": "^\\.(?:landing|funding-landing)/[a-z0-9][a-z0-9._-]+--[0-9a-f]{16}$"
        },
        "kind": {"enum": ["trade", "mark", "funding"]},
        "month": {"type": "string", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])$"},
        "planned_page_count": {"type": "integer", "minimum": 1, "maximum": 100000},
        "request": {"type": "object"},
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "sequence": {"type": "integer", "minimum": 0, "maximum": 2879}
      }
    }
  }
}
