{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brullik/brullik-bybit-grid-bot-research/schemas/market/v1/funding-source-boundary-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "discovery_id",
    "max_attempts",
    "max_pages_per_symbol",
    "page_limit",
    "registry_sha256",
    "request",
    "request_sha256",
    "series",
    "software_identity",
    "target_rps",
    "workers"
  ],
  "properties": {
    "contract": {"const": "grid.bybit-funding-source-boundary-plan/v1"},
    "discovery_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$"},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 5},
    "max_pages_per_symbol": {"type": "integer", "minimum": 1, "maximum": 512},
    "page_limit": {"type": "integer", "minimum": 1, "maximum": 200},
    "registry_sha256": {"$ref": "#/$defs/sha256"},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "discovery_id",
        "end_ms",
        "max_attempts",
        "max_pages_per_symbol",
        "page_limit",
        "start_ms",
        "symbols",
        "target_rps",
        "workers"
      ],
      "properties": {
        "contract": {"const": "grid.bybit-funding-source-boundary-request/v1"},
        "discovery_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$"},
        "end_ms": {"type": "integer", "minimum": 0, "multipleOf": 60000},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 5},
        "max_pages_per_symbol": {"type": "integer", "minimum": 1, "maximum": 512},
        "page_limit": {"type": "integer", "minimum": 1, "maximum": 200},
        "start_ms": {"type": "integer", "minimum": 0, "multipleOf": 60000},
        "symbols": {
          "type": "array",
          "minItems": 1,
          "maxItems": 700,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z0-9]+$"}
        },
        "target_rps": {"type": "integer", "minimum": 1, "maximum": 96},
        "workers": {"type": "integer", "minimum": 1, "maximum": 32}
      }
    },
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "series": {
      "type": "array",
      "minItems": 1,
      "maxItems": 700,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instrument_id", "scan_end_ms", "scan_start_ms", "symbol"],
        "properties": {
          "instrument_id": {"type": "integer", "minimum": 1, "maximum": 4294967295},
          "scan_end_ms": {"type": "integer", "minimum": 0},
          "scan_start_ms": {"type": "integer", "minimum": 0},
          "symbol": {"type": "string", "pattern": "^[A-Z0-9]+$"}
        }
      }
    },
    "software_identity": {"type": "string", "pattern": "^git:[0-9a-f]{40}$"},
    "target_rps": {"type": "integer", "minimum": 1, "maximum": 96},
    "workers": {"type": "integer", "minimum": 1, "maximum": 32}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
