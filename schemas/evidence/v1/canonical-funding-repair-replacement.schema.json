{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brullik/brullik-bybit-grid-bot-research/schemas/evidence/v1/canonical-funding-repair-replacement.schema.json",
  "title": "Immutable canonical funding repair replacement proof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bindings",
    "chronology",
    "content_sha256",
    "contract",
    "generated_at_utc",
    "limitations",
    "lineage",
    "replacement_software_identity",
    "row_accounting",
    "status",
    "storage_policy"
  ],
  "properties": {
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capacity_evidence_sha256",
        "instrument_registry_sha256",
        "parent_manifest_sha256",
        "repair_execution_artifact_sha256",
        "repair_plan_artifact_sha256",
        "replacement_manifest_sha256"
      ],
      "properties": {
        "capacity_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "instrument_registry_sha256": {"$ref": "#/$defs/sha256"},
        "parent_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "repair_execution_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "repair_plan_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "replacement_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "chronology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duplicate_key_count",
        "exact_source_confirmation",
        "inserted_settlement_count",
        "restated_interval_count",
        "unexpected_key_count"
      ],
      "properties": {
        "duplicate_key_count": {"const": 0},
        "exact_source_confirmation": {"const": true},
        "inserted_settlement_count": {"type": "integer", "minimum": 1, "maximum": 1000},
        "restated_interval_count": {"type": "integer", "minimum": 1, "maximum": 1000},
        "unexpected_key_count": {"const": 0}
      }
    },
    "content_sha256": {"$ref": "#/$defs/sha256"},
    "contract": {"const": "grid.canonical-funding-repair-replacement/v1"},
    "generated_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "limitations": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_dataset_id",
        "parent_dataset_mutated",
        "parent_ids_in_manifest",
        "replacement_dataset_id"
      ],
      "properties": {
        "parent_dataset_id": {"$ref": "#/$defs/parentDatasetId"},
        "parent_dataset_mutated": {"const": false},
        "parent_ids_in_manifest": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/parentDatasetId"}
        },
        "replacement_dataset_id": {"$ref": "#/$defs/replacementDatasetId"}
      }
    },
    "replacement_software_identity": {"$ref": "#/$defs/softwareIdentity"},
    "row_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_row_count", "repaired_row_count", "replacement_row_count"],
      "properties": {
        "parent_row_count": {"type": "integer", "minimum": 1},
        "repaired_row_count": {"type": "integer", "minimum": 1, "maximum": 1000},
        "replacement_row_count": {"type": "integer", "minimum": 2}
      }
    },
    "status": {"const": "passed"},
    "storage_policy": {
      "const": {
        "account_data_included": false,
        "instrument_identifiers_included": false,
        "market_values_included": false,
        "runtime_paths_included": false,
        "settlement_timestamps_included": false
      }
    }
  },
  "$defs": {
    "parentDatasetId": {"type": "string", "pattern": "^funding-[0-9a-f]{24}$"},
    "replacementDatasetId": {"type": "string", "pattern": "^funding-repair-[0-9a-f]{24}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "softwareIdentity": {"type": "string", "pattern": "^git:[0-9a-f]{40}$"}
  }
}
