{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brullik/brullik-bybit-grid-bot-research/schemas/evidence/v1/reference-layout-benchmark.schema.json",
  "title": "Staged reference layout benchmark",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_schema",
    "cache_semantics",
    "command",
    "hardware",
    "limitations",
    "measurements",
    "preparation",
    "profile",
    "status"
  ],
  "properties": {
    "benchmark_schema": {"const": "grid.reference-layout-benchmark/v1"},
    "cache_semantics": {"type": "string", "minLength": 1},
    "command": {"type": "string", "minLength": 1},
    "hardware": {"$ref": "#/$defs/hardware"},
    "limitations": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "measurements": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/measurement"}
    },
    "preparation": {"$ref": "#/$defs/preparation"},
    "profile": {"enum": ["smoke", "reference"]},
    "status": {
      "enum": ["local-smoke-only", "reference-synthetic-protocol-candidate"]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"profile": {"const": "smoke"}}},
      "then": {"properties": {"status": {"const": "local-smoke-only"}}},
      "else": {
        "properties": {"status": {"const": "reference-synthetic-protocol-candidate"}}
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "metric": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{9}$"},
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_count_logical", "cpu_count_physical", "machine", "platform", "ram_bytes"],
      "properties": {
        "cpu_count_logical": {"type": ["integer", "null"], "minimum": 1},
        "cpu_count_physical": {"type": ["integer", "null"], "minimum": 1},
        "machine": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "ram_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket_count", "compression", "compression_level", "numeric_representation", "target_file_mb"],
      "properties": {
        "bucket_count": {"enum": [4, 8]},
        "compression": {"enum": ["zstd", "snappy"]},
        "compression_level": {"type": ["integer", "null"]},
        "numeric_representation": {"enum": ["decimal128", "hybrid_int64_decimal"]},
        "target_file_mb": {"enum": [16, 32]}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modified_ns", "path", "sha256", "size"],
      "properties": {
        "modified_ns": {"type": "integer", "minimum": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1}
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_count", "files", "total_bytes", "tree_sha256"],
      "properties": {
        "file_count": {"type": "integer", "minimum": 1},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/file"}
        },
        "total_bytes": {"type": "integer", "minimum": 1},
        "tree_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "rewrite": {
      "type": "object",
      "required": ["elapsed_seconds", "manifest", "numeric_schema_verified", "row_count"],
      "properties": {
        "elapsed_seconds": {"$ref": "#/$defs/metric"},
        "manifest": {"$ref": "#/$defs/manifest"},
        "numeric_schema_verified": {"const": true},
        "row_count": {"type": "integer", "minimum": 1}
      }
    },
    "logicalSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duckdb_polars_equal", "logical_sha256", "values"],
      "properties": {
        "duckdb_polars_equal": {"const": true},
        "logical_sha256": {"$ref": "#/$defs/sha256"},
        "values": {
          "type": "object",
          "minProperties": 10,
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compaction",
        "fragmentation",
        "logical_parity_verified",
        "repair",
        "source_bucket",
        "source_logical_summary",
        "source_row_count",
        "source_tree_unchanged"
      ],
      "properties": {
        "compaction": {
          "allOf": [
            {"$ref": "#/$defs/rewrite"},
            {
              "type": "object",
              "required": ["input_fragment_bytes", "input_fragment_count", "output_to_input_byte_ratio"],
              "properties": {
                "input_fragment_bytes": {"type": "integer", "minimum": 1},
                "input_fragment_count": {"const": 8},
                "output_to_input_byte_ratio": {"$ref": "#/$defs/metric"}
              }
            }
          ]
        },
        "fragmentation": {"$ref": "#/$defs/rewrite"},
        "logical_parity_verified": {"const": true},
        "repair": {
          "allOf": [
            {"$ref": "#/$defs/rewrite"},
            {
              "type": "object",
              "required": ["output_to_source_byte_ratio"],
              "properties": {
                "output_to_source_byte_ratio": {"$ref": "#/$defs/metric"}
              }
            }
          ]
        },
        "source_bucket": {"type": "string", "minLength": 1},
        "source_logical_summary": {"$ref": "#/$defs/logicalSummary"},
        "source_row_count": {"type": "integer", "minimum": 2},
        "source_tree_unchanged": {"const": true}
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_path", "layout", "maintenance", "manifest", "write"],
      "properties": {
        "dataset_path": {"type": "string", "minLength": 1},
        "layout": {"$ref": "#/$defs/layout"},
        "maintenance": {"$ref": "#/$defs/maintenance"},
        "manifest": {"$ref": "#/$defs/manifest"},
        "write": {
          "type": "object",
          "required": ["bytes", "file_count", "numeric_schema_verified", "write_seconds"],
          "properties": {
            "bytes": {"type": "integer", "minimum": 1},
            "file_count": {"type": "integer", "minimum": 1},
            "numeric_schema_verified": {"const": true},
            "write_seconds": {"$ref": "#/$defs/metric"}
          }
        }
      }
    },
    "timedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_path",
        "first_seconds",
        "observed_row_count",
        "post_scan_content_verified",
        "pre_scan_metadata_verified",
        "result_sha256",
        "warm_seconds"
      ],
      "properties": {
        "dataset_path": {"type": "string", "minLength": 1},
        "first_seconds": {"$ref": "#/$defs/metric"},
        "observed_row_count": {"type": "integer", "minimum": 1},
        "post_scan_content_verified": {"const": true},
        "pre_scan_metadata_verified": {"const": true},
        "result_sha256": {"$ref": "#/$defs/sha256"},
        "warm_seconds": {"$ref": "#/$defs/metric"}
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boot_marker",
        "cache_proof",
        "command",
        "engine",
        "hardware",
        "measurement_schema",
        "measurements",
        "preparation",
        "profile",
        "query_shape",
        "status"
      ],
      "properties": {
        "boot_marker": {"type": "string", "format": "date-time"},
        "cache_proof": {"enum": ["reboot", "unverified-smoke"]},
        "command": {"type": "string", "minLength": 1},
        "engine": {"enum": ["duckdb", "polars"]},
        "hardware": {"$ref": "#/$defs/hardware"},
        "measurement_schema": {"const": "grid.reference-layout-measurement/v1"},
        "measurements": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/timedResult"}
        },
        "preparation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact", "artifact_sha256"],
          "properties": {
            "artifact": {"const": "preparation.json"},
            "artifact_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "profile": {"enum": ["smoke", "reference"]},
        "query_shape": {"enum": ["single-symbol", "universe-month"]},
        "status": {"enum": ["reboot-separated-first-read", "unverified-smoke-read"]}
      }
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "artifact_sha256",
        "boot_marker",
        "datasets",
        "decision_evidence",
        "input",
        "source_semantics"
      ],
      "properties": {
        "artifact": {"const": "preparation.json"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "boot_marker": {"type": "string", "format": "date-time"},
        "datasets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/dataset"}
        },
        "decision_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact", "artifact_sha256", "benchmark_schema", "status"],
          "properties": {
            "artifact": {"const": "m1-layout-exact-decision-candidate.json"},
            "artifact_sha256": {"$ref": "#/$defs/sha256"},
            "benchmark_schema": {"const": "grid.layout-benchmark/v3"},
            "status": {"const": "decision-matrix-candidate"}
          }
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["generation_chunk_rows", "instrument_count", "row_count", "row_group_rows"],
          "properties": {
            "generation_chunk_rows": {"type": "integer", "minimum": 1},
            "instrument_count": {"type": "integer", "minimum": 8},
            "row_count": {"type": "integer", "minimum": 8},
            "row_group_rows": {"type": "integer", "minimum": 1}
          }
        },
        "source_semantics": {"const": "deterministic-exact-synthetic-v1"}
      }
    }
  }
}
