{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brullik/brullik-bybit-grid-bot-research/schemas/evidence/v1/bybit-1m-gap-repair-plan.schema.json",
  "title": "Bounded Bybit one-minute gap repair plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bindings",
    "content_sha256",
    "contract",
    "dataset_id",
    "generated_at_utc",
    "limits",
    "mutation_policy",
    "planner_software_identity",
    "status",
    "tasks"
  ],
  "properties": {
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_manifest_sha256",
        "coverage_audit_artifact_sha256",
        "coverage_audit_content_sha256",
        "history_manifest_sha256"
      ],
      "properties": {
        "canonical_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "coverage_audit_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "coverage_audit_content_sha256": {"$ref": "#/$defs/sha256"},
        "history_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "content_sha256": {"$ref": "#/$defs/sha256"},
    "contract": {"const": "grid.bybit-1m-gap-repair-plan/v1"},
    "dataset_id": {"type": "string", "pattern": "^(trade|mark)-1m-[0-9a-f]{24}$"},
    "generated_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_repair_http_requests",
        "max_repair_tasks",
        "planned_max_http_requests",
        "task_count",
        "total_missing_minutes"
      ],
      "properties": {
        "max_repair_http_requests": {"const": 100000},
        "max_repair_tasks": {"const": 1000},
        "planned_max_http_requests": {"type": "integer", "minimum": 1, "maximum": 100000},
        "task_count": {"type": "integer", "minimum": 1, "maximum": 1000},
        "total_missing_minutes": {"type": "integer", "minimum": 1}
      }
    },
    "mutation_policy": {
      "const": {
        "canonical_dataset_mutated": false,
        "market_requests_executed": false,
        "repair_requests_embedded_only": true
      }
    },
    "planner_software_identity": {
      "type": "string",
      "pattern": "^git:[0-9a-f]{40}$"
    },
    "status": {"const": "planned"},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/task"}
    }
  },
  "$defs": {
    "historyRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "job_id",
        "kind",
        "max_attempts",
        "max_http_requests",
        "page_limit",
        "series",
        "target_rps",
        "workers"
      ],
      "properties": {
        "contract": {"const": "grid.bybit-1m-history-request/v1"},
        "job_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
        "kind": {"enum": ["trade", "mark"]},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 5},
        "max_http_requests": {"type": "integer", "minimum": 1, "maximum": 100000},
        "page_limit": {"type": "integer", "minimum": 1, "maximum": 1000},
        "series": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["end_ms", "start_ms", "symbol"],
            "properties": {
              "end_ms": {"$ref": "#/$defs/minute"},
              "start_ms": {"$ref": "#/$defs/minute"},
              "symbol": {"type": "string", "pattern": "^[A-Z0-9]+$"}
            }
          }
        },
        "target_rps": {"type": "integer", "minimum": 1, "maximum": 96},
        "workers": {"type": "integer", "minimum": 1, "maximum": 32}
      }
    },
    "minute": {"type": "integer", "minimum": 0, "multipleOf": 60000},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "end_ms",
        "instrument_id",
        "minute_count",
        "page_count",
        "request",
        "request_sha256",
        "sequence",
        "start_ms",
        "symbol"
      ],
      "properties": {
        "end_ms": {"$ref": "#/$defs/minute"},
        "instrument_id": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "minute_count": {"type": "integer", "minimum": 1},
        "page_count": {"type": "integer", "minimum": 1},
        "request": {"$ref": "#/$defs/historyRequest"},
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "sequence": {"type": "integer", "minimum": 0, "maximum": 999},
        "start_ms": {"$ref": "#/$defs/minute"},
        "symbol": {"type": "string", "pattern": "^[A-Z0-9]+$"}
      }
    }
  }
}
