{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brullik/brullik-bybit-grid-bot-research/schemas/evidence/v1/bybit-1m-gap-repair-execution.schema.json",
  "title": "Bounded Bybit one-minute gap repair execution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bindings",
    "content_sha256",
    "contract",
    "dataset_id",
    "executor_software_identity",
    "generated_at_utc",
    "limitations",
    "limits",
    "mutation_policy",
    "status",
    "storage_policy",
    "tasks"
  ],
  "properties": {
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_parent_manifest_sha256",
        "capacity_evidence_sha256",
        "coverage_audit_artifact_sha256",
        "coverage_audit_content_sha256",
        "original_history_manifest_sha256",
        "instrument_registry_sha256",
        "repair_plan_artifact_sha256",
        "repair_plan_content_sha256"
      ],
      "properties": {
        "canonical_parent_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "capacity_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "coverage_audit_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "coverage_audit_content_sha256": {"$ref": "#/$defs/sha256"},
        "original_history_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "instrument_registry_sha256": {"$ref": "#/$defs/sha256"},
        "repair_plan_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "repair_plan_content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "content_sha256": {"$ref": "#/$defs/sha256"},
    "contract": {"const": "grid.bybit-1m-gap-repair-execution/v1"},
    "dataset_id": {"type": "string", "pattern": "^(trade|mark)-1m-[0-9a-f]{24}$"},
    "executor_software_identity": {"$ref": "#/$defs/softwareIdentity"},
    "generated_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "limitations": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actual_http_requests",
        "missing_minute_count",
        "observed_row_count",
        "planned_max_http_requests",
        "task_count",
        "total_missing_minutes"
      ],
      "properties": {
        "actual_http_requests": {"type": "integer", "minimum": 0, "maximum": 100000},
        "missing_minute_count": {"type": "integer", "minimum": 0},
        "observed_row_count": {"type": "integer", "minimum": 0},
        "planned_max_http_requests": {"type": "integer", "minimum": 1, "maximum": 100000},
        "task_count": {"type": "integer", "minimum": 1, "maximum": 1000},
        "total_missing_minutes": {"type": "integer", "minimum": 1}
      }
    },
    "mutation_policy": {
      "const": {
        "market_requests_executed": true,
        "parent_dataset_mutated": false,
        "replacement_dataset_published": false
      }
    },
    "status": {"enum": ["passed", "blocked"]},
    "storage_policy": {
      "const": {
        "account_data_included": false,
        "market_values_included": false,
        "runtime_paths_included": false
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/task"}
    }
  },
  "$defs": {
    "minute": {"type": "integer", "minimum": 0, "multipleOf": 60000},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "softwareIdentity": {"type": "string", "pattern": "^git:[0-9a-f]{40}$"},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actual_http_requests",
        "end_ms",
        "exact_gap_coverage",
        "history_manifest_sha256",
        "history_plan_sha256",
        "instrument_id",
        "job_directory",
        "minute_count",
        "missing_minute_count",
        "observed_row_count",
        "page_count",
        "request_sha256",
        "sequence",
        "start_ms",
        "status",
        "symbol"
      ],
      "properties": {
        "actual_http_requests": {"type": "integer", "minimum": 0, "maximum": 100000},
        "end_ms": {"$ref": "#/$defs/minute"},
        "exact_gap_coverage": {"type": "boolean"},
        "history_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "history_plan_sha256": {"$ref": "#/$defs/sha256"},
        "instrument_id": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "job_directory": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,159}$"},
        "minute_count": {"type": "integer", "minimum": 1},
        "missing_minute_count": {"type": "integer", "minimum": 0},
        "observed_row_count": {"type": "integer", "minimum": 0},
        "page_count": {"type": "integer", "minimum": 1},
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "sequence": {"type": "integer", "minimum": 0, "maximum": 999},
        "start_ms": {"$ref": "#/$defs/minute"},
        "status": {"enum": ["passed", "blocked"]},
        "symbol": {"type": "string", "pattern": "^[A-Z0-9]+$"}
      }
    }
  }
}
