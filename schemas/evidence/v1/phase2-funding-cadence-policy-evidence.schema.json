{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brullik/brullik-bybit-grid-bot-research/schemas/evidence/v1/phase2-funding-cadence-policy-evidence.schema.json",
  "title": "Dated official Bybit funding-cadence policy consistency evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assurances",
    "bindings",
    "content_sha256",
    "contract",
    "generated_at_utc",
    "limitations",
    "official_policy",
    "quality",
    "source_policy",
    "status",
    "storage_policy"
  ],
  "properties": {
    "assurances": {
      "const": {
        "canonical_market_data_mutated": false,
        "coverage_audit_receipts_verified": true,
        "funding_landing_receipts_verified": true,
        "market_data_network_request_performed": false,
        "official_announcement_response_count": 1,
        "private_endpoint_called": false
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "official_article_response_sha256",
        "official_policy_marker_sha256",
        "software_identity",
        "sources"
      ],
      "properties": {
        "official_article_response_sha256": {"$ref": "#/$defs/sha256"},
        "official_policy_marker_sha256": {"$ref": "#/$defs/sha256"},
        "software_identity": {"$ref": "#/$defs/softwareIdentity"},
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "coverage_audit_artifact_sha256",
              "coverage_audit_content_sha256",
              "funding_manifest_sha256",
              "interval_change_count"
            ],
            "properties": {
              "coverage_audit_artifact_sha256": {"$ref": "#/$defs/sha256"},
              "coverage_audit_content_sha256": {"$ref": "#/$defs/sha256"},
              "funding_manifest_sha256": {"$ref": "#/$defs/sha256"},
              "interval_change_count": {"$ref": "#/$defs/count"}
            }
          }
        }
      }
    },
    "content_sha256": {"$ref": "#/$defs/sha256"},
    "contract": {"const": "grid.phase2-funding-cadence-policy-evidence/v1"},
    "generated_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "limitations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "official_policy": {
      "const": {
        "announcement_date": "2026-02-23",
        "documented_default_interval_minutes": [120, 240, 480],
        "dynamic_adjustment_without_further_notice": true,
        "effective_at_ms": 1772074800000,
        "hourly_interval_minutes": 60,
        "qualifying_rate_threshold_decimal": "0.00025",
        "qualifying_settlement_count": 16,
        "restoration_period_ordinal": 17,
        "source_url": "https://announcements.bybit.com/en/article/important-update-to-perpetual-contract-funding-settlement-frequency-blt9e1f8c588fe457c7/"
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "affected_series_count",
        "completed_hourly_episode_count",
        "coverage_audit_count",
        "explained_interval_change_count",
        "hourly_episode_count",
        "observed_interval_change_count",
        "open_hourly_episode_count",
        "open_nonqualifying_hourly_episode_count",
        "policy_consistent_series_count",
        "qualifying_settlement_count_histogram",
        "series_count",
        "unexplained_interval_change_count"
      ],
      "properties": {
        "affected_series_count": {"$ref": "#/$defs/count"},
        "completed_hourly_episode_count": {"$ref": "#/$defs/count"},
        "coverage_audit_count": {"type": "integer", "minimum": 1, "maximum": 32},
        "explained_interval_change_count": {"$ref": "#/$defs/count"},
        "hourly_episode_count": {"$ref": "#/$defs/count"},
        "observed_interval_change_count": {"$ref": "#/$defs/count"},
        "open_hourly_episode_count": {"$ref": "#/$defs/count"},
        "open_nonqualifying_hourly_episode_count": {"$ref": "#/$defs/count"},
        "policy_consistent_series_count": {"$ref": "#/$defs/count"},
        "qualifying_settlement_count_histogram": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["episode_count", "qualifying_settlement_count"],
            "properties": {
              "episode_count": {"type": "integer", "minimum": 1, "maximum": 700},
              "qualifying_settlement_count": {"type": "integer", "minimum": 16, "maximum": 17}
            }
          }
        },
        "series_count": {"type": "integer", "minimum": 1, "maximum": 22400},
        "unexplained_interval_change_count": {"$ref": "#/$defs/count"}
      }
    },
    "source_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authentication",
        "exact_url_only",
        "maximum_response_bytes",
        "normalized_policy_text_sha256",
        "private_endpoints_called",
        "transport_max_attempts"
      ],
      "properties": {
        "authentication": {"const": "none"},
        "exact_url_only": {"const": true},
        "maximum_response_bytes": {"const": 2097152},
        "normalized_policy_text_sha256": {"$ref": "#/$defs/sha256"},
        "private_endpoints_called": {"const": false},
        "transport_max_attempts": {"const": 1}
      }
    },
    "status": {
      "enum": [
        "blocked-unexplained-funding-cadence",
        "verified-official-funding-cadence-policy-consistency"
      ]
    },
    "storage_policy": {
      "const": {
        "account_data_included": false,
        "announcement_body_included": false,
        "credentials_included": false,
        "funding_rates_included": false,
        "instrument_identifiers_included": false,
        "observed_settlement_timestamps_included": false,
        "runtime_paths_included": false
      }
    }
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0, "maximum": 10000000},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "softwareIdentity": {"type": "string", "pattern": "^git:[0-9a-f]{40}$"}
  }
}
