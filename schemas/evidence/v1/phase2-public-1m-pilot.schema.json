{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brullik/brullik-bybit-grid-bot-research/schemas/evidence/v1/phase2-public-1m-pilot.schema.json",
  "title": "Sanitized Phase 2 public one-minute canonical pilot evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bindings",
    "canonical",
    "content_sha256",
    "evidence_schema",
    "generated_at_utc",
    "landing",
    "limitations",
    "publication",
    "scope",
    "source_policy",
    "status",
    "storage_policy"
  ],
  "properties": {
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_config_sha256",
        "capacity_evidence_sha256",
        "coverage_evidence_sha256",
        "input_table_sha256",
        "instrument_registry_sha256"
      ],
      "properties": {
        "build_config_sha256": {"$ref": "#/$defs/sha256"},
        "capacity_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "coverage_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "input_table_sha256": {"$ref": "#/$defs/sha256"},
        "instrument_registry_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "canonical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "dataset_type",
        "file_count",
        "instrument_count",
        "manifest_sha256",
        "max_time_ms",
        "min_time_ms",
        "parquet_bytes",
        "row_count",
        "schema_version",
        "semantic_version"
      ],
      "properties": {
        "dataset_id": {"type": "string", "pattern": "^(trade|mark)-1m-[0-9a-f]{24}$"},
        "dataset_type": {"enum": ["trade_kline_1m", "mark_kline_1m"]},
        "file_count": {"type": "integer", "minimum": 1, "maximum": 64},
        "instrument_count": {"type": "integer", "minimum": 1, "maximum": 16},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "max_time_ms": {"$ref": "#/$defs/minute"},
        "min_time_ms": {"$ref": "#/$defs/minute"},
        "parquet_bytes": {"type": "integer", "minimum": 1},
        "row_count": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "schema_version": {"const": "v1"},
        "semantic_version": {"const": "1.0.0"}
      }
    },
    "content_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_schema": {"const": "grid.phase2-public-1m-pilot/v1"},
    "generated_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "landing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actual_http_requests",
        "contract",
        "empty_page_count",
        "manifest_sha256",
        "page_count",
        "request_sha256",
        "returned_row_count",
        "target_rps",
        "workers"
      ],
      "properties": {
        "actual_http_requests": {"type": "integer", "minimum": 1, "maximum": 100000},
        "contract": {"const": "grid.bybit-1m-history-acquisition/v1"},
        "empty_page_count": {"type": "integer", "minimum": 0, "maximum": 100000},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "page_count": {"type": "integer", "minimum": 1, "maximum": 100000},
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "returned_row_count": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "target_rps": {"type": "integer", "minimum": 1, "maximum": 96},
        "workers": {"type": "integer", "minimum": 1, "maximum": 32}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existing_commit_verified",
        "layout_contract",
        "parquet_compression",
        "parquet_compression_level",
        "software_identity",
        "target_file_size_bytes"
      ],
      "properties": {
        "existing_commit_verified": {"const": true},
        "layout_contract": {"const": "grid.canonical-candle-layout/v1"},
        "parquet_compression": {"const": "zstd"},
        "parquet_compression_level": {"const": 3},
        "software_identity": {"type": "string", "pattern": "^git:[0-9a-f]{40}$"},
        "target_file_size_bytes": {"const": 16777216}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "exact_requested_coverage",
        "interval_minutes",
        "requested_minute_count",
        "series"
      ],
      "properties": {
        "category": {"const": "linear"},
        "exact_requested_coverage": {"const": true},
        "interval_minutes": {"const": 1},
        "requested_minute_count": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "series": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/series"}
        }
      }
    },
    "source_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authentication",
        "base_url",
        "endpoint",
        "private_endpoints_called",
        "tick_rows_requested"
      ],
      "properties": {
        "authentication": {"const": "none"},
        "base_url": {"const": "https://api.bybit.com"},
        "endpoint": {"enum": ["/v5/market/kline", "/v5/market/mark-price-kline"]},
        "private_endpoints_called": {"const": false},
        "tick_rows_requested": {"const": false}
      }
    },
    "status": {"const": "verified-canonical-publication"},
    "storage_policy": {
      "const": {
        "evidence_contains_account_data": false,
        "evidence_contains_market_values": false,
        "runtime_market_artifacts_committed_to_git": false,
        "runtime_market_dataset_receipt_verified": true
      }
    }
  },
  "$defs": {
    "minute": {"type": "integer", "minimum": 0, "multipleOf": 60000},
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["end_ms", "instrument_id", "requested_minute_count", "start_ms", "symbol"],
      "properties": {
        "end_ms": {"$ref": "#/$defs/minute"},
        "instrument_id": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "requested_minute_count": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "start_ms": {"$ref": "#/$defs/minute"},
        "symbol": {"type": "string", "pattern": "^[A-Z0-9]+$"}
      }
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
