{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grid.canonical-dataset-selection/v1",
  "title": "Canonical dataset range selection evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog", "content_sha256", "evidence_schema", "generated_at_utc", "limitations",
    "objects", "request", "request_sha256", "required_partitions",
    "selected_dataset_manifests", "selection", "safety", "status"
  ],
  "properties": {
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_sha256", "revision", "schema_version"],
      "properties": {
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "revision": {"type": "integer", "minimum": 1},
        "schema_version": {"const": 1}
      }
    },
    "content_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_schema": {"const": "grid.canonical-dataset-selection/v1"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "limitations": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dataset_id", "file_sha256", "manifest_sha256", "max_instrument_id", "max_time_ms",
          "min_instrument_id", "min_time_ms", "object_key", "row_count", "size_bytes"
        ],
        "properties": {
          "dataset_id": {"$ref": "#/$defs/datasetId"},
          "file_sha256": {"$ref": "#/$defs/sha256"},
          "manifest_sha256": {"$ref": "#/$defs/sha256"},
          "max_instrument_id": {"type": "integer", "minimum": 1, "maximum": 4294967295},
          "max_time_ms": {"type": "integer", "minimum": 0},
          "min_instrument_id": {"type": "integer", "minimum": 1, "maximum": 4294967295},
          "min_time_ms": {"type": "integer", "minimum": 0},
          "object_key": {
            "type": "string",
            "pattern": "^datasets/[a-z0-9][a-z0-9._-]{2,127}/dataset=(trade_kline_1m|mark_kline_1m|funding_event)/schema=v1/year=[0-9]{4}/month=(0[1-9]|1[0-2])/bucket=0[0-7]/[a-z0-9][a-z0-9._-]*\\.parquet$"
          },
          "row_count": {"type": "integer", "minimum": 1},
          "size_bytes": {"type": "integer", "minimum": 1}
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_content_sha256", "catalog_revision", "consumer_software_identity", "dataset_ids",
        "dataset_type", "end_time_ms", "instrument_filter", "request_schema", "start_time_ms"
      ],
      "properties": {
        "catalog_content_sha256": {"$ref": "#/$defs/sha256"},
        "catalog_revision": {"type": "integer", "minimum": 1},
        "consumer_software_identity": {"type": "string", "pattern": "^git:[0-9a-f]{40}$"},
        "dataset_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/datasetId"}},
        "dataset_type": {"enum": ["trade_kline_1m", "mark_kline_1m", "funding_event"]},
        "end_time_ms": {"type": "integer", "minimum": 0, "multipleOf": 60000},
        "instrument_filter": {
          "oneOf": [
            {
              "type": "object", "additionalProperties": false, "required": ["mode"],
              "properties": {"mode": {"const": "all"}}
            },
            {
              "type": "object", "additionalProperties": false, "required": ["instrument_ids", "mode"],
              "properties": {
                "instrument_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 4294967295}},
                "mode": {"const": "include"}
              }
            }
          ]
        },
        "request_schema": {"const": "grid.canonical-dataset-selection-request/v1"},
        "start_time_ms": {"type": "integer", "minimum": 0, "multipleOf": 60000}
      }
    },
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "required_partitions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^dataset=(trade_kline_1m|mark_kline_1m|funding_event)/schema=v1/year=[0-9]{4}/month=(0[1-9]|1[0-2])/bucket=0[0-7]$"}
    },
    "selected_dataset_manifests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dataset_id", "manifest_sha256"],
        "properties": {
          "dataset_id": {"$ref": "#/$defs/datasetId"},
          "manifest_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_count", "selected_row_inventory", "selected_size_bytes"],
      "properties": {
        "object_count": {"type": "integer", "minimum": 1},
        "selected_row_inventory": {"type": "integer", "minimum": 1},
        "selected_size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["absolute_paths_included", "account_data_included", "credentials_included", "market_values_included", "receipt_verified_inputs"],
      "properties": {
        "absolute_paths_included": {"const": false},
        "account_data_included": {"const": false},
        "credentials_included": {"const": false},
        "market_values_included": {"const": false},
        "receipt_verified_inputs": {"const": true}
      }
    },
    "status": {"const": "passed"}
  },
  "$defs": {
    "datasetId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
